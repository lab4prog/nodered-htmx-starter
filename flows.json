    {
        "id": "418ed979dd3fd9ea",
        "type": "function",
        "z": "8ebee3b55772fac1",
        "name": "setMainFile",
        "func": "const type = env.get(\"type\") || \"page\";\nconst name = env.get(\"name\") || msg.name;\nconst folder = type === \"component\" ? \"components\" : \"pages\";\n\n// file names only: letters, digits, _ and -, subfolders with \"/\" - no \"..\", no absolute paths\nconst SAFE = /^[A-Za-z0-9_-]+(\\/[A-Za-z0-9_-]+)*$/;\nif (!SAFE.test(name || \"\")) throw new Error(`Invalid view name: ${name}`);\n\nmsg.project_path = env.get(\"PROJECT_PATH\");\nmsg.filename = `${msg.project_path}/public/${folder}/${name}.html`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 150,
        "y": 260,
        "wires": [
            [
                "cf862678c74a9499"
            ]
