        "name": "toggleTodo",
        "func": "const todos = global.get(\"todos\") || [];\nconst todo = todos.find(t => t.id === Number(msg.req.params.id));\n\nif (!todo) {\n    msg.notification = { message: \"Task not found\", type: \"error\" };\n} else {\n    todo.done = !todo.done;\n    global.set(\"todos\", todos);\n    msg.notification = { message: todo.done ? \"Task completed\" : \"Task reopened\", type: \"info\" };\n}\n\nmsg.todos = todos;\nreturn msg;",
