        "type": "function",
        "z": "025d5a9e74400e55",
        "name": "findComponents",
        "func": "msg.iterationCount = (msg.iterationCount || 0) + 1;\nconst maxRecursion = env.get(\"maxRecursion\") || 10;\n\nif (msg.iterationCount > maxRecursion) {\n  node.error(\"Recursion limit exceeded\", msg);\n  return null;\n}\n\nconst mainTemplate = msg.payload;\nconst regex = /<([A-Z][A-Za-z0-9_-]*)\\s*(?:\\/>|>.*?<\\/\\1>)/gs;\nconst matches = [...mainTemplate.matchAll(regex)];\n\nlet foundTags = [];\n\nif (matches.length > 0) {\n  foundTags = [...new Set(matches.map(match => match[1]))];\n}\n\nmsg.payload = foundTags;\nmsg.mainTemplate = mainTemplate;\n\nreturn msg;",
