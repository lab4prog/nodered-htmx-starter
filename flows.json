    {
        "id": "c38c06503ef1b2b6",
        "type": "function",
        "z": "8ebee3b55772fac1",
        "name": "findComponents",
        "func": "msg.iterationCount = (msg.iterationCount || 0) + 1;\nconst maxRecursion = env.get(\"maxRecursion\") || 10;\n\nif (msg.iterationCount > maxRecursion) {\n  node.error(\"Recursion limit exceeded\", msg);\n  return null;\n}\n\nconst mainTemplate = msg.payload;\nconst regex = /<([A-Z][A-Za-z0-9_-]*)(?:\\s+[A-Za-z_][\\w.-]*(?:=\"[^\"]*\")?)*\\s*(?:\\/>|>[\\s\\S]*?<\\/\\1>)/g;\nconst matches = [...mainTemplate.matchAll(regex)];\n\nlet foundTags = [];\n\nif (matches.length > 0) {\n  foundTags = [...new Set(matches.map(match => match[1]))];\n}\n\nmsg.payload = foundTags;\nmsg.mainTemplate = mainTemplate;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 120,
        "wires": [
