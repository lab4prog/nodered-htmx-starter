        "z": "697c8c6f713661f2",
        "name": "validate",
        "func": "// rules (env, JSON): { \"field\": { \"label\", \"required\", \"minLength\", \"maxLength\", \"pattern\", \"message\" } }\nconst rules = env.get(\"rules\") || {};\nconst data = Object.assign({}, msg.payload);\nconst errors = {};\n\nfor (const [field, rule] of Object.entries(rules)) {\n    const value = String(data[field] ?? \"\").trim();\n    const label = rule.label || field;\n    data[field] = value;\n\n    if (rule.required && !value) {\n        errors[field] = `${label} is required`;\n    } else if (value && rule.minLength && value.length < rule.minLength) {\n        errors[field] = `${label} must be at least ${rule.minLength} characters`;\n    } else if (rule.maxLength && value.length > rule.maxLength) {\n        errors[field] = `${label} must be at most ${rule.maxLength} characters`;\n    } else if (value && rule.pattern && !new RegExp(rule.pattern).test(value)) {\n        errors[field] = rule.message || `${label} is invalid`;\n    }\n}\n\nmsg.payload = data;   // trimmed values for the business logic\nmsg.errors = Object.keys(errors).length ? errors : null;\n\nif (msg.errors) {\n    // values for re-rendering the form: submitted fields + route params (e.g. id)\n    msg.form = Object.assign({}, data, msg.req && msg.req.params);\n    msg.statusCode = 422;\n}\nreturn msg;",
