        "name": "deleteTodo",
        "func": "const id = Number(msg.req.params.id);\nconst todos = global.get(\"todos\") || [];\nconst rest = todos.filter(t => t.id !== id);\n\nif (rest.length === todos.length) {\n    msg.notification = { message: \"Task not found\", type: \"error\" };\n} else {\n    global.set(\"todos\", rest);\n    msg.notification = { message: \"Task deleted\", type: \"success\" };\n}\n\nmsg.todos = rest;\nreturn msg;",
