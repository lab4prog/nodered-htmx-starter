        "name": "errorResponse",
        "func": "// errors in endpoint logic (outside View) - answer 500 instead of letting the request hang;\n// errors handled by catch are not logged, so log it here (node.warn: node.error would loop)\nnode.warn(msg.error.message);\n\n// not an HTTP request (e.g. seedTodos) or already answered (e.g. link call timeout after a 500)\nif (!msg.res || msg.res._res.headersSent) return null;\n\nconst notFound = /ENOENT/.test(msg.error.message);   // e.g. a missing file in /assets\nmsg.statusCode = notFound ? 404 : 500;\nmsg.payload = notFound ? \"Not found\" : \"Server error\";\nmsg.headers = {};   // drop headers set before the error (e.g. Content-Type of an asset)\nreturn msg;",
