    {
        "id": "01e1f44ba7c4217e",
        "type": "switch",
        "z": "8ebee3b55772fac1",
        "name": "has <Component />?",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "regex",
                "v": "<([A-Z][A-Za-z0-9_-]*)(?:\\s+[A-Za-z_][\\w.-]*(?:=\"[^\"]*\")?)*\\s*(?:\\/>|>[\\s\\S]*?<\\/\\1>)",
                "vt": "str",
                "case": false
            },
