    {
        "id": "4897a4bdeb3aa1d7",
        "type": "function",
        "z": "8ebee3b55772fac1",
        "name": "replace <component>",
        "func": "const html = msg.mainTemplate;\nconst components = msg.payload;\nconst TAG = /<([A-Z][A-Za-z0-9_-]*)((?:\\s+[A-Za-z_][\\w.-]*(?:=\"[^\"]*\")?)*)\\s*(?:\\/>|>([\\s\\S]*?)<\\/\\1>)/g;\nconst ATTR = /([A-Za-z_][\\w.-]*)(?:=\"([^\"]*)\")?/g;\nconst SLOT = /<slot\\s*\\/>|<slot>([\\s\\S]*?)<\\/slot>/g;\n\nmsg._props = msg._props || {};\n\nmsg.payload = html.replace(TAG, (match, name, attrs, inner) => {\n  let component = components[name];\n  if (!component) return match;\n\n  // content between the tags goes into <slot>, otherwise the slot's fallback is used\n  component = component.replace(SLOT, (s, fallback) => (inner && inner.trim()) ? inner : (fallback || \"\"));\n\n  // props: data=\"path\" renders the component with msg.path as context (an array repeats it),\n  // other attributes are static props: <Card title=\"Tasks\"> -> {{title}} inside Card.html\n  const props = {};\n  let data = null;\n  for (const [, key, value] of (attrs || \"\").matchAll(ATTR)) {\n    if (key === \"data\") data = value;\n    else props[key] = value === undefined ? true : value;\n  }\n  if (data) {\n    if (!/^[A-Za-z_][\\w.]*$/.test(data)) throw new Error(`Invalid data=\"${data}\" in <${name}>`);\n    component = `{{#${data}}}${component}{{/${data}}}`;\n  }\n  if (Object.keys(props).length) {\n    // the final Mustache render looks values up: data item -> props -> msg\n    const id = \"p\" + (Object.keys(msg._props).length + 1);\n    msg._props[id] = props;\n    component = `{{#_props.${id}}}${component}{{/_props.${id}}}`;\n  }\n  return component;\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 120,
        "wires": [
            [
                "01e1f44ba7c4217e"
            ]
        ]
    },
    {
        "id": "b4ab25311902b17c",
        "type": "function",
        "z": "8ebee3b55772fac1",
        "name": "prepResponse",
        "func": "// the assembled page becomes the Mustache template for \"render output\"\nmsg.template = msg.payload;\n\nmsg.headers = msg.headers || {};\n\nif (msg.notification) {\n\n    const safeMessage = encodeURIComponent(msg.notification.message);\n    const type = msg.notification.type || 'info';\n\n    msg.headers['HX-Trigger'] = `{\"showToast\":{\"message\":\"${safeMessage}\",\"type\":\"${type}\"}}`;\n\n    msg.headers['Cache-Control'] = 'no-store';\n    msg.headers['Access-Control-Expose-Headers'] = 'HX-Trigger';\n} else {\n    delete msg.headers['HX-Trigger'];\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
