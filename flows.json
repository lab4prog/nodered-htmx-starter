        "type": "function",
        "z": "025d5a9e74400e55",
        "name": "setMainFile",
        "func": "const main = env.get(\"mainComponent\") || \"index\";\nconst projectPath = env.get(\"PROJECT_PATH\");\nlet cache = global.get(\"cache\") || {};\n\n\nmsg.project_path = projectPath;\nmsg.filename = `${projectPath}/public/components/${main}.html`;\nconst cache_component = cache[msg.filename];\n\nif (!cache_component){\n    msg.is_catche = false;\n} else {\n    msg.payload = cache_component\n    msg.is_catche = true;\n}\nreturn msg;",
