        "name": "filterTodos",
        "func": "// ?filter=all|active|done\n// a page request (GET) takes it from its own URL,\n// an action (POST/PUT/PATCH/DELETE) - from the page it was sent from (HX-Current-URL header)\nconst fromUrl = url => (/[?&]filter=([^&#]*)/.exec(url || \"\") || [])[1];\nconst param = msg.req.method === \"GET\" ? msg.req.query.filter : fromUrl(msg.req.headers[\"hx-current-url\"]);\nconst filter = [\"active\", \"done\"].includes(param) ? param : \"all\";\n\nconst todos = msg.todos || [];\nmsg.activeCount = todos.filter(t => !t.done).length;   // counter in the page title, before filtering\nmsg.todos = filter === \"active\" ? todos.filter(t => !t.done)\n          : filter === \"done\"   ? todos.filter(t => t.done)\n          : todos;\nmsg.filter = { [filter]: true };   // {{#filter.active}} in the template\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
