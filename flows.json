        "func": "let filename;\nconst projectPath = env.get(\"PROJECT_PATH\");\nif (msg.req.url.endsWith(\"manifest.webmanifest\")) {\n    let projectName = \"\"; \n    if (msg.req.headers.referer) {\n        let parts = msg.req.headers.referer.split(\"/\");\n        projectName = parts[parts.length - 1];\n    }\n    filename = `${projectPath}/public/index.html`;\n} else {\n    filename = `${projectPath}/public/index.html`;\n}\n\nmsg.filename = filename;\nreturn msg;\n",
